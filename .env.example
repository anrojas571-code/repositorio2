# ============================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO (RESEND API)
# ============================================================
# 1. Regístrate gratis en https://resend.com y genera tu API Key (comienza con re_...).
# 2. Asigna la clave aquí debajo:

RESEND_API_KEY=re_tu_api_key_aqui

# Remitente de correo (por defecto onboarding@resend.dev para pruebas)
EMAIL_FROM=Sistema de Usuarios <onboarding@resend.dev>

# ============================================================
# CONFIGURACIÓN DEL SERVIDOR LOCAL Y NOMBRE DEL SISTEMA
# ============================================================
PORT=3000
SYSTEM_NAME=Sistema de Gestión de Usuarios
HOST_NAME=sistema.local

# ============================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO (GMAIL / SMTP)
# ============================================================

# Si usas Gmail (@gmail.com):
# 1. Activa la Verificación en 2 pasos en tu cuenta de Google.
# 2. Genera una "Contraseña de Aplicación" (App Password) desde:
#    https://myaccount.google.com/apppasswords
# 3. Coloca tu correo en EMAIL_USER y la contraseña de 16 caracteres en EMAIL_PASS (sin espacios).

EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Remitente personalizado (Opcional)
EMAIL_FROM="Sistema de Usuarios" <tu_correo@gmail.com>

# ============================================================
# CONFIGURACIÓN DE BASE DE DATOS POSTGRESQL (OPCIONAL)
# Si no se define DATABASE_URL, el sistema usará db.json local.
# ============================================================
# DATABASE_URL=postgres://usuario:password@host:5432/dbname

# PORT=3000
